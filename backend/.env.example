# 应用配置（可用环境变量覆盖）
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除

# ── 服务 ──────────────────────────────────────────────
APP_NAME=电商工作台
APP_VERSION=0.1.0
DEBUG=true

# ── 数据库 ────────────────────────────────────────────
# MVP：SQLite（零依赖，开箱即跑）
DATABASE_URL=sqlite:///./data/workbench.db
# 生产：切PostgreSQL（需安装 psycopg）
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/workbench

# ── dsh 内核（Agent 编排层）───────────────────────────
# 本机已在 8787 运行；生产必须经自己后端转发，禁止浏览器直连
KERNEL_BASE_URL=http://127.0.0.1:8787
KERNEL_TIMEOUT_SECONDS=120

# ── 内容规格（来自 docs/02-内容规格与合规基线）────────
XHS_COVER_ASPECT=3:4
XHS_TITLE_MAX_CHARS=20
XHS_BODY_MIN_CHARS=300
XHS_BODY_MAX_CHARS=800
XHS_TAGS_MIN=3
XHS_TAGS_MAX=5
XHS_IMG_MIN=4
XHS_IMG_MAX=8

# ── 选题转换（四条差异化规则，见 docs/07）────────────
# 二次创作至少满足的差异化维度数量
XHS_DIFFERENTIATION_MIN=3
# 同质化相似度阈值（超过判低质）
XHS_SIMILARITY_LIMIT=0.70
